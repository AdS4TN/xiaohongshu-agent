# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=Asia/Shanghai

# Database
DATABASE_URL=sqlite:///data/radar.sqlite

# API Tokens
GITHUB_TOKEN=
HF_TOKEN=

# Codex/OpenAI-compatible writing model.
# 用于热点摘要、博客 A/B 层文字，以及 C 层资料搜集后的最终报告撰写。
# 支持逗号分隔候选模型，按顺序尝试；若包含 gpt-5.5，会自动补充回退到 gpt-5.4。
LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5,gpt-5.4
MAX_LLM_CANDIDATES_PER_RUN=30

# Blog A/B writing model. 默认复用 OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL。
# 同样支持候选模型列表；留空则复用 OPENAI_MODEL。
BLOG_ANALYSIS_BASE_URL=
BLOG_ANALYSIS_MODEL=
BLOG_ANALYSIS_TIMEOUT_SECONDS=120
ENABLE_BLOG_ANALYSIS_LLM=true

# Research sub-agent.
# 只负责 C 层联网资料搜集包；最终成稿仍由 OPENAI_* 写作模型完成。
RESEARCH_AGENT_BASE_URL=http://127.0.0.1:40444/api/grok/v1/chat/completions
RESEARCH_AGENT_MODEL=grok-4.20-multi-agent-xhigh
RESEARCH_AGENT_TIMEOUT_SECONDS=180

# GitHub 项目信息扩展流水线
# 搜索 AI：联网扩展资料，不使用 API key。
GITHUB_INFO_SEARCH_BASE_URL=http://127.0.0.1:40444/api/grok/v1
GITHUB_INFO_SEARCH_MODEL=grok-4.20-multi-agent-xhigh
GITHUB_INFO_SEARCH_TIMEOUT_SECONDS=360

# 审核 AI：核对搜索结果是否有网页来源支撑。
GITHUB_INFO_REVIEW_BASE_URL=
GITHUB_INFO_REVIEW_API_KEY=
GITHUB_INFO_REVIEW_MODEL=gpt-5.5,gpt-5.4

# 摘要 AI：只综合审核通过的信息写日报摘要。
GITHUB_INFO_SUMMARY_BASE_URL=
GITHUB_INFO_SUMMARY_API_KEY=
GITHUB_INFO_SUMMARY_MODEL=gpt-5.5,gpt-5.4
GITHUB_INFO_WRITER_TIMEOUT_SECONDS=240
MCP_GIT_INGEST_LOCAL_PATH=C:/Users/28377/mcp-git-ingest-local

# GitHub 项目社区信号爬虫：HN / Reddit / Linux.do / Product Hunt / 博客 / Newsletter。
ENABLE_GITHUB_INFO_COMMUNITY_SIGNALS=true
COMMUNITY_SIGNAL_TIMEOUT_SECONDS=30
COMMUNITY_SIGNAL_MAX_RESULTS_PER_PLATFORM=6
# 可选：临时填写从浏览器 DevTools 复制出的 linux.do Cookie 请求头，用于登录态搜索。
# 不建议提交真实 Cookie。
LINUX_DO_COOKIE_HEADER=

# Reddit 官方 OAuth API（推荐作为主路径）。
# 需要先在 Reddit 创建 app，拿到 client_id / client_secret，并设置唯一 User-Agent。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Reddit 浏览器登录态 fallback（推荐先用这个做通）。
# 第一次运行 scripts/reddit_browser_login.py 后，后续采集器会直接复用该 profile。
REDDIT_BROWSER_PROFILE_DIR=data/browser_profiles/reddit
REDDIT_BROWSER_CHANNEL=chrome
# Reddit 在 headless Chrome 下常返回 403；Windows 桌面环境建议保持 false。
REDDIT_BROWSER_HEADLESS=false

# Reddit Devvit bridge：Devvit app 回调本地服务时使用。
# 部署到公网时请设置一个随机长 token；本地调试可留空。
REDDIT_DEVVIT_SHARED_TOKEN=
REDDIT_DEVVIT_WATCHLIST_LIMIT=50
# Devvit app setting: aiRadarBaseUrl=http://47.250.164.154:2050

# Blog JSON export
PUBLIC_EXPORT_DIR=public_exports/ai-hotspots
# 可选：填写你的博客项目静态数据目录后，会同步一份 JSON 到博客项目。
BLOG_EXPORT_DIR=
BLOG_DETAIL_BASE_PATH=/ai-hotspots
DAILY_CARD_LIMIT=8
DAILY_EXPORT_LOOKBACK_HOURS=48

# Scheduler
ENABLE_SCHEDULER=true
DAILY_RUN_TIME=08:00
EVENING_RUN_TIME=18:00

# News ????????AI Radar ?? GitHub Daily ????????????? SSE ?????
NEWS_DASHBOARD_WEBHOOK_URL=http://127.0.0.1:40444/api/news/github-trending/notify
NEWS_DASHBOARD_WEBHOOK_TOKEN=
NEWS_DASHBOARD_WEBHOOK_TIMEOUT_SECONDS=5
